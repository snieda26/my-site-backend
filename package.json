{
	"name": "itlead-api",
	"version": "1.0.0",
	"description": "ITLead - Interview preparation platform backend API",
	"author": "ITLead",
	"license": "MIT",
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"format": "prettier --write \"src/**/*.ts\"",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx drizzle/seed.ts",
		"import:questions": "tsx scripts/import-questions.ts",
		"translate:questions": "tsx scripts/translate-with-api.ts",
		"translate:test": "tsx scripts/translate-with-api.ts --dry-run --limit=3"
	},
	"dependencies": {
		"@faker-js/faker": "^9.3.0",
		"@nestjs/common": "^11.1.9",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.1.9",
		"@nestjs/jwt": "^11.0.1",
		"@nestjs/mapped-types": "^2.1.0",
		"@nestjs/platform-express": "^11.1.9",
		"@nestjs/serve-static": "^5.0.4",
		"@nestjs/swagger": "^11.2.4",
		"@nestlab/google-recaptcha": "^3.10.0",
		"@paralleldrive/cuid2": "^3.0.6",
		"argon2": "^0.44.0",
		"axios": "^1.13.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"cookie-parser": "^1.4.7",
		"drizzle-orm": "^0.45.1",
		"helmet": "^8.1.0",
		"mailgun.js": "^12.4.0",
		"nestjs-zod": "^5.0.1",
		"postgres": "^3.4.8",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^3.25.56"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.7",
		"@nestjs/schematics": "^11.0.5",
		"@nestjs/testing": "^11.1.9",
		"@types/cookie-parser": "^1.4.8",
		"@types/express": "^5.0.3",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.15.29",
		"@types/supertest": "^6.0.2",
		"drizzle-kit": "^0.31.8",
		"eslint": "^9.28.0",
		"jest": "^29.7.0",
		"prettier": "^3.5.3",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3"
	}
}
