generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// IDENTITY & AUTH
// ============================================

model Account {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  avatarUrl String?  @map("avatar_url")
  
  emailVerified   Boolean  @default(false) @map("email_verified")
  verifyToken     String?  @unique @default(uuid()) @map("verify_token")
  
  role            Role     @default(USER)
  
  // Onboarding completed flag
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  
  // Relations
  profile         UserProfile?
  progress        UserProgress[]
  solvedProblems  SolvedProblem[]
  bookmarks       Bookmark[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@index([email])
  @@map("accounts")
}

enum Role {
  USER
  ADMIN
}

// ============================================
// USER PROFILE & PREFERENCES
// ============================================

model UserProfile {
  id        String @id @default(cuid())
  
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @unique @map("account_id")
  
  // Experience & Target
  experienceLevel   ExperienceLevel @default(JUNIOR) @map("experience_level")
  targetPosition    TargetPosition  @default(MIDDLE) @map("target_position")
  yearsOfExperience Int?            @map("years_of_experience")
  
  // Learning preferences
  learningGoal      LearningGoal    @default(JOB_INTERVIEW) @map("learning_goal")
  weeklyHours       Int?            @map("weekly_hours") // Hours per week available for learning
  
  // Technologies to learn (stored as JSON array of slugs)
  technologies      String[]        @default([])
  
  // Focus areas (stored as JSON array)
  focusAreas        String[]        @default([]) @map("focus_areas")
  
  // Additional preferences
  preferredLanguage String?         @map("preferred_language") // "en" or "ua"
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@index([accountId])
  @@map("user_profiles")
}

enum ExperienceLevel {
  BEGINNER    // No commercial experience
  JUNIOR      // 0-1 years
  MIDDLE      // 1-3 years
  SENIOR      // 3+ years
  LEAD        // Team Lead / Architect
}

enum TargetPosition {
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
}

enum LearningGoal {
  JOB_INTERVIEW       // Preparing for job interview
  SKILL_IMPROVEMENT   // Improving existing skills
  CAREER_GROWTH       // Growing to next level
  KNOWLEDGE_REFRESH   // Refreshing existing knowledge
  CERTIFICATION       // Preparing for certification
}

// ============================================
// INTERVIEW QUESTIONS
// ============================================

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  icon        String?
  color       String?
  order       Int     @default(0)
  
  questions   Question[]
  progress    UserProgress[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([slug])
  @@map("categories")
}

model Question {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  content     String  @db.Text
  answer      String  @db.Text
  
  difficulty  Difficulty @default(MEDIUM)
  order       Int        @default(0)
  
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String   @map("category_id")
  
  tags        Tag[]
  bookmarks   Bookmark[]
  progress    UserProgress[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([categoryId])
  @@index([slug])
  @@index([difficulty])
  @@map("questions")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  questions Question[]
  problems  Problem[]
  
  @@map("tags")
}

// ============================================
// CODING PROBLEMS
// ============================================

model Problem {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String  @db.Text
  
  difficulty  Difficulty @default(MEDIUM)
  
  starterCode String  @map("starter_code") @db.Text
  solution    String  @db.Text
  testCases   String  @map("test_cases") @db.Text
  
  companies   Company[]
  tags        Tag[]
  
  solved      SolvedProblem[]
  bookmarks   Bookmark[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([slug])
  @@index([difficulty])
  @@map("problems")
}

model Company {
  id       String    @id @default(cuid())
  name     String    @unique
  logo     String?
  problems Problem[]
  
  @@map("companies")
}

model SolvedProblem {
  id        String @id @default(cuid())
  
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @map("account_id")
  
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId String  @map("problem_id")
  
  code      String  @db.Text
  status    SolveStatus @default(ATTEMPTED)
  
  solvedAt  DateTime @default(now()) @map("solved_at")
  
  @@unique([accountId, problemId])
  @@index([accountId])
  @@index([problemId])
  @@map("solved_problems")
}

enum SolveStatus {
  ATTEMPTED
  SOLVED
}

// ============================================
// USER PROGRESS & BOOKMARKS
// ============================================

model UserProgress {
  id        String @id @default(cuid())
  
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @map("account_id")
  
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String?   @map("category_id")
  
  question    Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String?   @map("question_id")
  
  status      ProgressStatus @default(NOT_STARTED)
  
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@unique([accountId, questionId])
  @@index([accountId])
  @@index([categoryId])
  @@map("user_progress")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Bookmark {
  id        String @id @default(cuid())
  
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @map("account_id")
  
  question    Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String?   @map("question_id")
  
  problem     Problem? @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId   String?  @map("problem_id")
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@unique([accountId, questionId])
  @@unique([accountId, problemId])
  @@index([accountId])
  @@map("bookmarks")
}
