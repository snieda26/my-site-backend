# Server
NODE_ENV=development
PORT=4200

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mine?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET=your-super-secret-access-key-change-me
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-me

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3002

# Google reCAPTCHA
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Mail (Mailgun) - Optional
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain
MAIL_FROM=noreply@itlead.com
